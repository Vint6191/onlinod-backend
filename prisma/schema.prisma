  id                  String   @id @default(cuid())
  agencyId            String
  creatorId           String
  moduleKey           String   @default("bumps")
  actionType          String   @default("SEND_MESSAGE")
  targetId            String?
  idempotencyKey      String?  @unique
  generation          Int      @default(1)
  priority            Int      @default(0)
  payload             Json     @default("{}")
  ruleId              String?
  contentCollectionId String?
  fanId               String
  dialogId            String?
  trigger             String?
  status              String   @default("scheduled") // P10: QUEUED | CLAIMED | RUNNING | RETRY_SCHEDULED | COMPLETED | FAILED | SKIPPED | CANCELED | PAUSED. Legacy bump rows keep old values until P11 migration.
  scheduledAt         DateTime?
  notBefore           DateTime @default(now())
