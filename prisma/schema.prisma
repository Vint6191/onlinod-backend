  tags            Json     @default("[]")
  status          String   @default("active") // active | archived | trash | deleted
  metadata        Json     @default("{}")
  clientId        String?
  createdByUserId String?
  updatedByUserId String?
  deletedAt       DateTime?
  purgeAfter      DateTime?
  trashedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  agency  Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  creator CreatorAccount? @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  blocks  ContentBlock[]

  @@unique([agencyId, clientId])
  @@index([agencyId, kind, status])
  @@index([creatorId, kind, status])
  @@index([updatedAt])
  @@index([deletedAt])
  @@index([purgeAfter])
