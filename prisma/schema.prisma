  @@index([agencyId, type, status])
  @@index([creatorId, status])
  @@index([taskId, status])
  @@index([claimedByDeviceId, claimedAt])
  @@index([status, completedAt])
  @@index([status, updatedAt])
  @@index([fanId])
  @@index([createdAt])
