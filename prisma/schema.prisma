/// LEGACY/DORMANT purchase payload table. New purchase facts and amounts are
/// local-only; the backend stores only reconciliation targets/jobs.
model DialogPurchaseSignal {
  id               String   @id @default(cuid())
  agencyId         String
  creatorId        String
  idempotencyKey   String   @unique
  sourceEventId    String?
  sourceMessageId  String?
  dialogId         String?
  buyerId          String?
  buyerUsername    String?
  buyerDisplayName String?
  buyerDeleted     Boolean  @default(false)
  occurredAt       DateTime
  amountCents      Int      @default(0)
  currency         String   @default("USD")
  source           String   @default("notification")
  resolveState     String   @default("PENDING")
  firstSeenAt      DateTime @default(now())
  lastSeenAt       DateTime @default(now())
  resolvedAt       DateTime?
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  agency  Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  creator CreatorAccount @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([creatorId, sourceEventId])
  @@index([creatorId, sourceMessageId])
  @@index([creatorId, dialogId, occurredAt])
  @@index([resolveState, lastSeenAt])
}

/// LEGACY/DORMANT server Vault projection retained for existing rows only.
/// Current Vault Asset Sales is projected from local dialog-messages.sqlite.
model VaultPurchaseLedger {
  id               String    @id @default(cuid())
  agencyId         String
  creatorId        String
  messageLedgerId  String?
  idempotencyKey   String    @unique
  sourceEventId    String?
  sourceMessageId  String?
  dialogId         String?
  buyerId          String?
