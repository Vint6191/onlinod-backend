generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  OPERATOR
}

enum CreatorStatus {
  DRAFT
  READY
  NOT_CREATOR
  AUTH_FAILED
  DISABLED
}

enum CustomOrderStatus {
  PENDING
  COMPLETED
  MISSED
  CANCELLED
}

enum CustomOrderType {
  CONTENT
  CALL
  PHYSICAL
}

enum CustomOrderContentKind {
  PHOTO
  VIDEO
  BOTH
}

enum CustomOrderPhysicalStatus {
  WAITING
  READY
  SHIPPED
  COMPLETED
}


enum AnalyticsDataType {
  EARNINGS
  NOTIFICATIONS
  NOTIFICATION_PURCHASES
  NOTIFICATION_TIPS
  NOTIFICATION_SUBSCRIPTIONS
  NOTIFICATION_LIKES
  NOTIFICATION_COMMENTS
  CAMPAIGNS
  SALES
  FINANCIAL_TRANSACTIONS
  PAID_SUBSCRIPTIONS
  MESSAGES_DAILY
}

enum AnalyticsCoverageStatus {
  MISSING
  QUEUED
  SCANNING
  PARTIAL
  COMPLETE
  FAILED
  UNAVAILABLE
}

enum AnalyticsIngestStatus {
  RECEIVED
  COMMITTED
  PARTIAL
  REJECTED
  FAILED
}

enum CreatorNotificationScanOutcome {
  ACCEPTED
  REJECTED
  IGNORED
}

enum CreatorNotificationScanFactType {
  PURCHASE
  TIP
  SUBSCRIPTION
  LIKE
  COMMENT
}

enum CreatorFinancialTransactionFactType {
  SALE
  TIP
  PAID_SUBSCRIPTION
  OTHER
}

enum CreatorFinancialTransactionProjectionStatus {
  PROJECTED
  STORED_ONLY
}

enum CreatorEarningsCategory {
  TOTAL
  SUBSCRIPTIONS
  MESSAGES
  TIPS
  POSTS
  STREAMS
}

enum CreatorSaleType {
  MESSAGE
  POST
  STREAM
  OTHER
}

enum CreatorSubscriptionEventType {
  SUBSCRIBED_FREE
  SUBSCRIBED_PAID
  SUBSCRIBED_UNKNOWN
  RENEWED
  RESUBSCRIBED
  EXPIRED
  AUTO_RENEW_ENABLED
  AUTO_RENEW_DISABLED
  REFUNDED
}


enum CreatorFactSource {
  NOTIFICATION
  LOCAL_MESSAGE_LEDGER
  ONLYFANS_API
  RECONCILIATION
}

enum CreatorPaidSubscriptionPaymentType {
  INITIAL
  RENEWAL
  RESUBSCRIPTION
}

enum CreatorSubscriptionStateStatus {
  UNKNOWN
  ACTIVE
  EXPIRED
}

enum CreatorCampaignAttributionSource {
  ONLYFANS_TRACKING
  NOTIFICATION
  SUBSCRIPTION_RECORD
  MANUAL
  INFERRED
}

enum CreatorCampaignAttributionConfidence {
  CONFIRMED
  PROBABLE
  WEAK
}

enum CreatorLocalCoverageStatus {
  MISSING
  PARTIAL
  COMPLETE
  FAILED
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  name            String?
  avatarUrl       String?
  emailVerifiedAt DateTime?
  isSuperAdmin   Boolean   @default(false)
  lastLoginAt     DateTime?
  disabledAt     DateTime?
  disabledReason String?
  sessionsRevokedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships     AgencyMember[]
  authTokens      AuthToken[]
  refreshSessions RefreshSession[]
  createdConnectSessions CreatorConnectSession[] @relation("ConnectSessionCreator")
  claimedConnectSessions CreatorConnectSession[] @relation("ConnectSessionClaimer")
  accessSnapshots AccessSnapshot[] @relation("SnapshotCreator")
  workerDevices WorkerDevice[]
  auditLogs AuditLog[]
  teamActivityEvents TeamActivityEvent[]
  messageTemplateUsageEvents MessageTemplateUsageEvent[]
  automationRuns AutomationRun[]
  automationLogs AutomationLog[]
  invitationsSent AgencyInvitation[] @relation("AgencyInvitationInvitedBy")

  @@index([disabledAt])
}

model Agency {
  id        String   @id @default(cuid())
  name      String
  plan      String   @default("trial")
  status    String   @default("TRIAL")
  trialEndsAt DateTime?
  currentPeriodEnd DateTime?
  deletedAt     DateTime?
  deletedReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  AgencyMember[]
  creators CreatorAccount[]
  telegramMtprotoAccounts AgencyTelegramMtprotoAccount[]
  connectSessions CreatorConnectSession[]
  accessSnapshots AccessSnapshot[]
  workerDevices WorkerDevice[]
  auditLogs AuditLog[]
  subscriptions AgencySubscription[]
  creatorBillingProfiles CreatorBillingProfile[]
  creatorBillingEntitlements CreatorBillingEntitlement[]
  billingOrders BillingOrder[]
  billingOrderLines BillingOrderLine[]
  billingWallets AgencyBillingWallet[]
  billingWalletTransactions BillingWalletTransaction[]
  creatorBillingPeriods CreatorBillingPeriod[]
  adminActionLogs AdminActionLog[]
  customRoles            AgencyCustomRole[]
  roleOverrides          AgencyRoleOverride[]
  subPermissionOverrides AgencySubPermissionOverride[]
  invitations            AgencyInvitation[]
  earningsSnapshots  CreatorEarningsSnapshot[]
  campaignsSnapshots CreatorCampaignsSnapshot[]
  jobs               JobInstance[]
  deviceCreatorBindings DeviceCreatorBinding[]
  teamActivityEvents TeamActivityEvent[]
  teamPpvClaimAudits TeamPpvClaimAudit[]
  teamMemberFunctions TeamMemberFunction[]
  teamCoverageSessions TeamCoverageSession[]
  teamDialogSessions TeamDialogSession[]
  teamResponseCases TeamResponseCase[]
  teamPendingDialogStates TeamPendingDialogState[]
  teamShifts TeamShift[]
  analyticsSnapshots AnalyticsSnapshot[]
  workspaceSettings WorkspaceSetting[]
  moduleSettings ModuleSetting[]
  messageTemplateGroups MessageTemplateGroup[]
  messageTemplates MessageTemplate[]
  messageTemplateUsageEvents MessageTemplateUsageEvent[]
  automationRules AutomationRule[]
  automationRuns AutomationRun[]
  automationLogs AutomationLog[]
  vaultUnsortedSnapshots VaultUnsortedSnapshot[]
  presenceSnapshots CreatorPresenceSnapshot[]
  presenceUsers     CreatorPresenceUser[]
  moneyAttributions MoneyAttribution[]
  mediaAssets       CreatorMediaAsset[]
  mediaUsageContributions CreatorMediaUsageContribution[]
  mediaUsageSourceStates CreatorMediaUsageSourceState[]
  mediaLibraryScanItems MediaLibraryScanItem[]
  contentCollections ContentCollection[]
  crmProfiles CrmProfile[]
  crmProfileTags CrmProfileTag[]
  crmProfileRawTags CrmProfileRawTag[]
  crmNotes CrmNote[]
  crmAnalysisRuns CrmAnalysisRun[]
  fanLists FanList[]
  fanListMembers FanListMember[]
  savedSegments SavedSegment[]
  campaignDrafts CampaignDraft[]
  campaignQueueStatuses CampaignQueueStatus[]
  automationDeliveries AutomationDelivery[]
  automationMonthlyAggregates AutomationMonthlyAggregate[]
  automationControls AutomationControlState[]
  followBackCandidates FollowBackCandidate[]
  followAutomationCandidates FollowAutomationCandidate[]
  sfsTargetCandidates SfsTargetCandidate[]
  automationBumpFanStates AutomationBumpFanState[]
  automationContentCandidates AutomationContentCandidate[]
  automationContentDiscoveryStates AutomationContentDiscoveryState[]
  hiddenOnlineUsers HiddenOnlineUser[]
  subscriberScanRuns SubscriberScanRun[]
  subscriberDirectoryStates SubscriberDirectoryState[]
  followBackTasks FollowBackTask[]
  vaultPurchaseMessages VaultPurchaseMessage[]
  vaultMediaSales VaultMediaSale[]
  dialogScanStates DialogScanState[]
  dialogScanRuns DialogScanRun[]
  dialogScanChunkCommits DialogScanChunkCommit[]
  dialogReconciliationTargets DialogReconciliationTarget[]
  dialogMessageLedgers DialogMessageLedger[]
  dialogMessageMedia DialogMessageMedia[]
  dialogPurchaseSignals DialogPurchaseSignal[]
  vaultPurchaseLedgers VaultPurchaseLedger[]
  vaultPurchaseMediaRelations VaultPurchaseMedia[]
  teamObservationStates TeamObservationState[]
  trafficSources TrafficSource[]
  trafficSourceMembers TrafficSourceMember[]
  trafficFanValueSnapshots TrafficFanValueSnapshot[]
  creatorSubscriptionLedgers CreatorSubscriptionLedger[]
  trafficDailyAggregates TrafficDailyAggregate[]
  customOrders CustomOrder[]

  @@index([deletedAt])
}


model AgencyTelegramMtprotoAccount {
  id               String @id @default(cuid())
  agencyId         String
  apiId            Int
  encryptedPayload String @db.Text
  iv               String
  tag              String
  algorithm        String @default("aes-256-gcm")
  payloadVersion   Int    @default(1)
  runtimeClaimedByDeviceId String?
  runtimeClaimToken        String?
  runtimeClaimUntil        DateTime?

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId])
}

model AgencyMember {
  id          String   @id @default(cuid())
  agencyId    String
  userId      String
  role        UserRole @default(OWNER)
  permissions Json?
  roleKey          String?
  displayName      String?
  initials         String?
  tone             String?
  commission       Json?
  assignedCreators Json?
  statusBadge      Json?
  lastSeenLabel    String?
  isTest           Boolean   @default(false)
  deletedAt        DateTime?
  deactivatedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamFunctions TeamMemberFunction[]
  teamCoverageSessions TeamCoverageSession[]
  teamDialogSessions TeamDialogSession[]
  teamResponseCases TeamResponseCase[]
  teamShifts TeamShift[]
  createdCustomOrders CustomOrder[]

  @@unique([agencyId, userId])
  @@index([agencyId])
  @@index([userId])
  @@index([roleKey])
  @@index([deletedAt])
  @@index([deactivatedAt])
}

model TeamMemberFunction {
  id          String   @id @default(cuid())
  agencyId    String
  memberId    String
  functionKey String
  createdAt   DateTime @default(now())

  agency Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  member AgencyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([agencyId, memberId, functionKey])
  @@index([agencyId, functionKey, memberId])
  @@index([memberId])
}

model CreatorAccount {
  id          String        @id @default(cuid())
  agencyId    String
  displayName String
  username    String?
  avatarUrl   String?
  remoteId    String?
  partition   String?
  status      CreatorStatus @default(DRAFT)
  notes       String?
  telegramContact   String?
  telegramUserId    String?
  telegramAccountId String?
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  connectSessions CreatorConnectSession[]
  accessSnapshots AccessSnapshot[]
  earningsSnapshots  CreatorEarningsSnapshot[]
  campaignsSnapshot  CreatorCampaignsSnapshot?
  jobs               JobInstance[]
  deviceCreatorBindings DeviceCreatorBinding[]
  teamActivityEvents TeamActivityEvent[]
  teamCoverageSessions TeamCoverageSession[]
  teamDialogSessions TeamDialogSession[]
  teamResponseCases TeamResponseCase[]
  teamPendingDialogStates TeamPendingDialogState[]
  teamShiftLinks TeamShiftCreator[]
  messageTemplateUsageEvents MessageTemplateUsageEvent[]
  vaultUnsortedSnapshots VaultUnsortedSnapshot[]
  presenceSnapshot CreatorPresenceSnapshot?
  presenceUsers    CreatorPresenceUser[]
  mediaAssets      CreatorMediaAsset[]
  mediaUsageContributions CreatorMediaUsageContribution[]
  mediaUsageSourceStates CreatorMediaUsageSourceState[]
  mediaLibraryScanItems MediaLibraryScanItem[]
  contentCollections ContentCollection[]
  crmProfiles CrmProfile[]
  crmNotes CrmNote[]
  crmAnalysisRuns CrmAnalysisRun[]
  fanLists FanList[]
  fanListMembers FanListMember[]
  savedSegments SavedSegment[]
  campaignDrafts CampaignDraft[]
  campaignQueueStatuses CampaignQueueStatus[]
  automationDeliveries AutomationDelivery[]
  automationMonthlyAggregates AutomationMonthlyAggregate[]
  automationControls AutomationControlState[]
  followBackCandidates FollowBackCandidate[]
  followAutomationCandidates FollowAutomationCandidate[]
  sfsTargetCandidates SfsTargetCandidate[]
  automationBumpFanStates AutomationBumpFanState[]
  automationContentCandidates AutomationContentCandidate[]
  automationContentDiscoveryStates AutomationContentDiscoveryState[]
  hiddenOnlineUsers HiddenOnlineUser[]
  subscriberScanRuns SubscriberScanRun[]
  subscriberDirectoryStates SubscriberDirectoryState[]
  followBackTasks FollowBackTask[]
  vaultPurchaseMessages VaultPurchaseMessage[]
  vaultMediaSales VaultMediaSale[]
  dialogScanStates DialogScanState[]
  dialogScanRuns DialogScanRun[]
  dialogScanChunkCommits DialogScanChunkCommit[]
  dialogReconciliationTargets DialogReconciliationTarget[]
  dialogMessageLedgers DialogMessageLedger[]
  dialogMessageMedia DialogMessageMedia[]
  dialogPurchaseSignals DialogPurchaseSignal[]
  vaultPurchaseLedgers VaultPurchaseLedger[]
  vaultPurchaseMediaRelations VaultPurchaseMedia[]
  teamObservationStates TeamObservationState[]
  trafficSources TrafficSource[]
  trafficSourceMembers TrafficSourceMember[]
  trafficFanValueSnapshots TrafficFanValueSnapshot[]
  creatorSubscriptionLedgers CreatorSubscriptionLedger[]
  trafficDailyAggregates TrafficDailyAggregate[]
  fans CreatorFan[]
  analyticsIngestBatches AnalyticsIngestBatch[]
  analyticsCoverage AnalyticsCoverage[]
  sales CreatorSale[]
  tips CreatorTip[]
  subscriptionEvents CreatorSubscriptionEvent[]
  subscriptionStates CreatorSubscriptionState[]
  paidSubscriptions CreatorPaidSubscription[]
  postLikes CreatorPostLike[]
  postComments CreatorPostComment[]
  earningsDaily CreatorEarningsDaily[]
  campaigns CreatorCampaign[]
  campaignMemberships CreatorCampaignFan[]
  messagesDaily CreatorMessagesDaily[]
  dailyMetrics CreatorDailyMetrics[]
  localMessageCoverage CreatorLocalMessageCoverage[]
  fanLocalCoverage CreatorFanLocalCoverage[]
  notificationSyncState CreatorNotificationSyncState?
  notificationScanItems CreatorNotificationScanItem[]
  financialTransactions CreatorFinancialTransaction[]
  fanValueCurrent CreatorFanValueCurrent[]
  earningsTotals CreatorEarningsTotal[]
  taskActivities CreatorTaskActivity[]
  customOrders CustomOrder[]

  @@unique([agencyId, id], map: "CreatorAccount_agencyId_id_key")
  @@index([agencyId])
  @@index([agencyId, telegramUserId])
  @@index([agencyId, telegramAccountId])
  @@index([status])
  @@index([deletedAt])
  billingProfile CreatorBillingProfile?
  billingEntitlement CreatorBillingEntitlement?
}

model CustomOrder {
  id                          String                    @id @default(cuid())
  agencyId                    String
  creatorId                   String
  dialogId                    String
  createdByMemberId           String
  scenario                    String
  internalNote                String?
  type                        CustomOrderType           @default(CONTENT)
  contentKind                 CustomOrderContentKind?
  status                      CustomOrderStatus         @default(PENDING)
  dueAt                       DateTime?
  scheduledAt                 DateTime?
  durationMinutes             Int?
  physicalStatus              CustomOrderPhysicalStatus?
  acceptedAt                  DateTime?
  completedAt                 DateTime?
  deliveredAt                 DateTime?
  cancelledAt                 DateTime?
  cancelReason                String?
  mediaIds                    String                    @default("")
  priceCents                  Int                       @default(0)
  paidAmountCents             Int                       @default(0)
  telegramTaskMessageId       Int?
  telegramReferenceMessageIds Int[]                     @default([])
  telegramLastModelMessageId  Int?
  telegramLastModelMessageAt  DateTime?
  reminderConfig              Json?
  nextReminderAt              DateTime?
  lastReminderAt              DateTime?
  lastReminderKey             String?
  reminderClaimToken          String?
  reminderClaimUntil          DateTime?
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt

  agency          Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  creator         CreatorAccount @relation(fields: [agencyId, creatorId], references: [agencyId, id], onDelete: Cascade)
  createdByMember AgencyMember  @relation(fields: [createdByMemberId], references: [id], onDelete: Restrict)

  @@index([agencyId, status, dueAt])
  @@index([agencyId, status, scheduledAt])
  @@index([agencyId, status, nextReminderAt])
  @@index([agencyId, creatorId, status, dueAt])
  @@index([agencyId, creatorId, status, scheduledAt])
  @@index([agencyId, creatorId, dialogId, createdAt])
  @@index([agencyId, creatorId, telegramTaskMessageId])
  @@index([creatorId, dialogId, status])
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  codeHash  String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([expiresAt])
}

model RefreshSession {
  id         String    @id @default(cuid())
  userId     String
  agencyId   String
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  deviceId   String?
  client     String?
  rememberDevice Boolean @default(false)
  impersonatedByAdminId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([agencyId])
  @@index([expiresAt])
  @@index([deviceId])
  @@index([impersonatedByAdminId])
}


enum ConnectSessionStatus {
  PENDING
  CLAIMED
  COMPLETED
  EXPIRED
  CANCELLED
}

enum AccessSnapshotType {
  OF_ACCESS
}


model CreatorConnectSession {
  id                String               @id @default(cuid())
  agencyId          String
  creatorId         String
  createdByUserId   String
  claimedByUserId   String?
  claimedByDeviceId String?
  tokenHash         String               @unique
  status            ConnectSessionStatus @default(PENDING)
  connectUrl        String?
  expiresAt         DateTime
  createdAt         DateTime             @default(now())
  claimedAt         DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?

  agency        Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  creator       CreatorAccount @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  createdByUser User           @relation("ConnectSessionCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  claimedByUser User?          @relation("ConnectSessionClaimer", fields: [claimedByUserId], references: [id], onDelete: SetNull)

  @@index([agencyId])
  @@index([creatorId])
  @@index([createdByUserId])
  @@index([status])
  @@index([expiresAt])
}

model AccessSnapshot {
  id              String             @id @default(cuid())
  agencyId        String
  creatorId       String
  createdByUserId String
  deviceId        String?
  type            AccessSnapshotType @default(OF_ACCESS)
  payloadVersion  Int                @default(1)
  encryptedPayload String
  iv              String
  tag             String
  algorithm       String             @default("aes-256-gcm")
  userAgentHash   String?
  remoteId        String?
  username        String?
  active          Boolean            @default(true)
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime           @default(now())

  agency        Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  creator       CreatorAccount @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  createdByUser User           @relation("SnapshotCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([agencyId])
  @@index([creatorId])
  @@index([createdByUserId])
  @@index([active])
  @@index([createdAt])
}

model WorkerDevice {
  id         String   @id @default(cuid())
  agencyId   String
  userId     String
  deviceName String?
  platform   String?
  appVersion String?
  lastSeenAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  creatorBindings DeviceCreatorBinding[]
  teamActivityEvents TeamActivityEvent[]
  presenceSnapshotsUpdated CreatorPresenceSnapshot[] @relation("PresenceSnapshotUpdatedByDevice")
  presenceUsersUpdated     CreatorPresenceUser[]     @relation("PresenceUserUpdatedByDevice")
  analyticsIngestBatches   AnalyticsIngestBatch[]
  creatorSalesCollected    CreatorSale[] @relation("CreatorSaleCollectedByDevice")
  creatorTipsCollected     CreatorTip[] @relation("CreatorTipCollectedByDevice")
  creatorSubscriptionEventsCollected CreatorSubscriptionEvent[] @relation("CreatorSubscriptionEventCollectedByDevice")
  creatorPostLikesCollected CreatorPostLike[] @relation("CreatorPostLikeCollectedByDevice")
  creatorPostCommentsCollected CreatorPostComment[] @relation("CreatorPostCommentCollectedByDevice")
  creatorEarningsDailyCollected CreatorEarningsDaily[] @relation("CreatorEarningsDailyCollectedByDevice")
  creatorCampaignsCollected CreatorCampaign[] @relation("CreatorCampaignCollectedByDevice")
  creatorCampaignFansCollected CreatorCampaignFan[] @relation("CreatorCampaignFanCollectedByDevice")
  creatorMessagesDailyCollected CreatorMessagesDaily[] @relation("CreatorMessagesDailyCollectedByDevice")
  creatorPaidSubscriptionsCollected CreatorPaidSubscription[] @relation("CreatorPaidSubscriptionCollectedByDevice")
  creatorFinancialTransactionsCollected CreatorFinancialTransaction[] @relation("CreatorFinancialTransactionCollectedByDevice")
  creatorFanValuesCollected CreatorFanValueCurrent[] @relation("CreatorFanValueCurrentCollectedByDevice")
  creatorEarningsTotalsCollected CreatorEarningsTotal[] @relation("CreatorEarningsTotalCollectedByDevice")
  creatorLocalMessageCoverage CreatorLocalMessageCoverage[]
  creatorFanLocalCoverage CreatorFanLocalCoverage[]

  @@index([agencyId])
  @@index([userId])
  @@index([lastSeenAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  agencyId    String
  actorUserId String?
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([agencyId])
  @@index([agencyId, createdAt])
  @@index([actorUserId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}


enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  GRACE
  CANCELLED
  LOCKED
}

enum BillingMode {
  MANUAL
  STRIPE
  CRYPTO
  FREE_INTERNAL
}

enum CreatorBillingTier {
  STARTER
  GROWTH
  PRO
  ELITE
  CUSTOM
}

enum BillingPeriod {
  MONTHLY
  THREE_MONTHS
  SIX_MONTHS
}

enum BillingProvider {
  NOWPAYMENTS
}

enum BillingEntitlementSource {
  PAYMENT
  ADMIN
  LEGACY
  WALLET
}

enum BillingOrderPurpose {
  SUBSCRIPTION
  WALLET_TOP_UP
}

enum BillingWalletTransactionType {
  TOP_UP
  SUBSCRIPTION_DEBIT
  TOP_UP_REFUND
  ADMIN_ADJUSTMENT
}

enum CreatorBillingPeriodStatus {
  ACTIVE
  COMPLETED
  LEGACY
}

enum BillingOrderStatus {
  CREATED
  CHECKOUT_CREATED
  PROCESSING
  PARTIALLY_PAID
  PAID
  EXPIRED
  FAILED
  REFUNDED
  CANCELLED
}


model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("SUPER_ADMIN")
  active       Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions AdminSession[]

  @@index([email])
  @@index([active])
}

model AdminSession {
  id           String   @id @default(cuid())
  adminUserId  String
  tokenHash    String   @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model AgencySubscription {
  id        String @id @default(cuid())
  agencyId String

  status    SubscriptionStatus @default(TRIAL)
  billingMode BillingMode @default(MANUAL)
  billingPeriod BillingPeriod @default(MONTHLY)

  corePricePerCreatorCents Int @default(2000)
  trialEndsAt DateTime?
  graceUntil DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId])
  @@index([status])
  @@index([currentPeriodEnd])
}

model CreatorBillingProfile {
  id        String @id @default(cuid())
  agencyId  String
  creatorId String @unique

  tier CreatorBillingTier @default(STARTER)
  tierMode String @default("AUTO")
  corePriceCents Int @default(2000)

  revenue30dCents Int @default(0)

  aiChatterEnabled Boolean @default(false)
  aiChatterPriceCents Int @default(10000)

  outreachEnabled Boolean @default(false)
  outreachPriceCents Int @default(2900)

  billingExcluded Boolean @default(false)
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  creator CreatorAccount @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([agencyId])
  @@index([tier])
  @@index([billingExcluded])
}

model BillingOrder {
  id              String             @id @default(cuid())
  agencyId        String
  createdByUserId String?
  provider        BillingProvider    @default(NOWPAYMENTS)
  purpose         BillingOrderPurpose @default(SUBSCRIPTION)
  status          BillingOrderStatus @default(CREATED)

  amountCents      Int
  currency         String            @default("USD")
  billingPeriod    BillingPeriod
  periodMonths     Int
