{
  "name": "onlinod-backend",
  "version": "0.7.1",
  "description": "Onlinod backend API + internal admin with dedicated admin login",
  "main": "src/server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "predev": "prisma generate",
    "dev": "node src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node scripts/database/install-current.js",
    "prisma:dev": "prisma migrate dev",
    "prisma:push": "node scripts/database/reject-schema-push.js",
    "postinstall": "prisma generate",
    "lint": "eslint \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\"",
    "test": "node --test \"src/**/*.test.js\"",
    "audit:p9": "node scripts/audit-p9-readonly.js",
    "maintenance:dedupe-deliveries": "node scripts/maintenance/dedupe-deliveries.js",
    "maintenance:purge-stuck-deliveries": "node scripts/maintenance/purge-stuck-deliveries.js",
    "audit:phase2-scale": "node scripts/audit/phase2-scale-readonly.js",
    "audit:phase2-coverage-preflight": "node scripts/audit/phase2-coverage-preflight-readonly.js",
    "phase3:provider-capacity": "node scripts/phase3-provider-capacity-debt.js",
    "maintenance:subscriber-signals": "node scripts/maintenance/phase3-subscriber-maintenance-signals.js",
    "audit:phase3-identifier-lint": "node scripts/audit/phase3-postgres-identifier-lint.js",
    "test:phase5-commit": "node scripts/audit/phase5-commit-test-gate.js",
    "audit:phase5-commit-postgres": "node scripts/audit/phase5-commit-postgres-proof.js",
    "test:phase5-team": "node scripts/audit/phase5-commit-test-gate.js phase5-team-command-tests.json",
    "audit:phase5-team-postgres": "node scripts/audit/phase5-team-command-postgres-proof.js",
    "test:phase5-jobs": "node scripts/audit/phase5-commit-test-gate.js phase5-job-lease-tests.json",
    "audit:phase5-jobs-postgres": "node scripts/audit/phase5-job-lease-postgres-proof.js",
    "test:phase5-admin-background": "node scripts/audit/phase5-commit-test-gate.js phase5-admin-background-tests.json",
    "audit:phase5-admin-background-postgres": "node scripts/audit/phase5-admin-background-postgres-proof.js",
    "test:phase5-history": "node scripts/audit/phase5-commit-test-gate.js phase5-notification-history-tests.json",
    "test:phase5-receipts": "node scripts/audit/phase5-commit-test-gate.js phase5-subscription-receipt-tests.json",
    "test:phase5-closure": "node scripts/audit/phase5-commit-test-gate.js phase5-closure-tests.json",
    "phase6:maintenance-admission": "node scripts/phase6-maintenance-admission.js",
    "test:auth-boundary": "node --test src/services/auth-boundary-recovery.test.js src/middleware/auth-device-logout-v20-21.test.js src/services/auth-device-session-isolation-v20-21.test.js src/services/actual59-int59-3-auth-lineage.test.js src/services/admin-session-client-races.test.js src/services/phase6-home-contract.test.js",
    "test:auth-sql": "node scripts/audit/auth-boundary-sql-proof.cjs",
    "test:all": "node scripts/test-all.cjs",
    "test:database": "node scripts/audit/current-clean-install-proof.cjs",
    "test:database-overlay": "node scripts/audit/current-install-overlay-proof.cjs",
    "test:admin-diagnostics": "node scripts/audit/current-admin-diagnostics-proof.cjs",
    "test:server-startup": "node scripts/audit/current-server-startup-proof.cjs",
    "test:product-acceptance": "node scripts/audit/current-product-acceptance-proof.cjs",
    "test:custom-acceptance": "node scripts/audit/current-custom-acceptance-proof.cjs",
    "test:automation-acceptance": "node scripts/audit/current-automation-acceptance-proof.cjs",
    "test:subscriber-acceptance": "node scripts/audit/current-subscriber-acceptance-proof.cjs",
    "test:analytics-acceptance": "node scripts/audit/current-analytics-acceptance-proof.cjs",
    "test:media-acceptance": "node scripts/audit/current-media-acceptance-proof.cjs"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "jsonwebtoken": "9.0.2",
    "multer": "1.4.5-lts.1",
    "prisma": "5.22.0",
    "resend": "4.0.1",
    "zod": "3.24.1",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "eslint": "9.29.0"
  },
  "devDependencies": {
    "prettier": "3.5.3",
    "@eslint/js": "9.29.0"
  }
}
