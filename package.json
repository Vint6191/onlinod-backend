{
  "name": "onlinod-backend",
  "version": "0.7.1",
  "description": "Onlinod backend API + internal admin with dedicated admin login",
  "main": "src/server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "predev": "prisma generate",
    "dev": "node src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node scripts/database/phase3-fandata-delivery-provenance-online-preflight.js && prisma migrate deploy && node scripts/database/actual60-refreshsession-online-index-preflight.js",
    "prisma:dev": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "postinstall": "prisma generate",
    "lint": "eslint \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\"",
    "test": "node --test \"src/**/*.test.js\"",
    "audit:p9": "node scripts/audit-p9-readonly.js",
    "maintenance:dedupe-deliveries": "node scripts/maintenance/dedupe-deliveries.js",
    "maintenance:purge-stuck-deliveries": "node scripts/maintenance/purge-stuck-deliveries.js",
    "db:baseline:v20.22": "node scripts/database/generate-production-baseline-v20-22.js",
    "audit:phase2-scale": "node scripts/audit/phase2-scale-readonly.js",
    "audit:phase2-coverage-preflight": "node scripts/audit/phase2-coverage-preflight-readonly.js",
    "phase2:team-control-plane": "node scripts/maintenance/phase2-team-control-plane-activation.js",
    "audit:auth-lifecycle": "node scripts/audit/actual59-auth-lifecycle-gate.js",
    "audit:auth-runtime-verify": "node scripts/audit/actual60-runtime-evidence-verify.js",
    "maintenance:auth-history-purge": "node scripts/maintenance/actual60-auth-history-purge-activation.js",
    "phase3:activate-campaign-causal-v1": "node scripts/phase3-activate-campaign-causal-v1.js",
    "phase3:activate-observation-creator-clock-v1": "node scripts/phase3-activate-observation-creator-clock-v1.js",
    "phase3:provider-gate-fairness": "node scripts/phase3-provider-gate-fairness-activation.js",
    "audit:phase3-a15-postgres": "node scripts/audit/phase3-a15-postgres-proof.js",
    "phase3:provider-capacity": "node scripts/phase3-provider-capacity-debt.js",
    "audit:phase3-a16-postgres": "node scripts/audit/phase3-a16-postgres-proof.js",
    "audit:phase3-a17-postgres": "node scripts/audit/phase3-a17-postgres-proof.js",
    "audit:phase3-a18-postgres": "node scripts/audit/phase3-a18-postgres-proof.js",
    "audit:phase3-a19-postgres": "node scripts/audit/phase3-a19-postgres-proof.js"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "jsonwebtoken": "9.0.2",
    "multer": "1.4.5-lts.1",
    "prisma": "5.22.0",
    "resend": "4.0.1",
    "zod": "3.24.1",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0"
  },
  "devDependencies": {
    "eslint": "9.29.0",
    "prettier": "3.5.3",
    "@eslint/js": "9.29.0"
  }
}
