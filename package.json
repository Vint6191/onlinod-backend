{
  "name": "onlinod-backend",
  "version": "0.7.1",
  "description": "Onlinod backend API + internal admin with dedicated admin login",
  "main": "src/server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:dev": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "postinstall": "prisma generate",
    "lint": "eslint \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\"",
    "test": "node --test \"src/**/*.test.js\"",
    "audit:p9": "node scripts/audit-p9-readonly.js",
    "maintenance:dedupe-deliveries": "node scripts/maintenance/dedupe-deliveries.js",
    "maintenance:purge-stuck-deliveries": "node scripts/maintenance/purge-stuck-deliveries.js",
    "db:baseline:v20.22": "node scripts/database/generate-production-baseline-v20-22.js"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "jsonwebtoken": "9.0.2",
    "multer": "1.4.5-lts.1",
    "prisma": "5.22.0",
    "resend": "4.0.1",
    "zod": "3.24.1",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0"
  },
  "devDependencies": {
    "eslint": "9.29.0",
    "prettier": "3.5.3",
    "@eslint/js": "9.29.0"
  }
}
